# Copy this file to ".env" for local overrides. ".env" is gitignored —
# never commit real secrets (decision D12). All values are optional; the
# defaults in app/config.py are safe for local development.

# STOCKMATE_DATABASE_URL=sqlite:///./stockmate.db
# STOCKMATE_BUSINESS_TIMEZONE=Asia/Tokyo
# STOCKMATE_BUSINESS_DAY_START_TIME=00:00
# STOCKMATE_SECRET_KEY=replace-with-a-long-random-string
